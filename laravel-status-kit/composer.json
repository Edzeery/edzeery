{
  "name": "edzeery/laravel-status-kit",
  "description": "Reusable Laravel Status & Presentation Kit with Blade, Filament and API support",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Edzeery\\LaravelStatusKit\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Edzeery\\LaravelStatusKit\\StatusKitServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  }
}